# Discord OAuth2 Configuration
# Get these from https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# Discord Redirect URIs
# For server-side OAuth2 callback
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord
# For client-side OAuth2 redirect
NEXT_PUBLIC_DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord

# API Configuration
API_PROTOCOL=https
API_URL=your-api-domain.com

# WebSocket Configuration
# For local development: ws://localhost:4000
# For HTTPS/production hosting: wss://your-domain.com
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# Recommendation API URL
# Deploy your own Soundy API from: https://github.com/idMJA/Soundy-API
# Then replace this URL with your deployed Vercel app URL
RECOMMENDATION_API_URL=https://your-soundy-api.vercel.app

# JWT/Session Secret (Shared between Soundy Bot API and Soundy Dashboard)
JWT_SECRET=your_jwt_secret_key_here

# Optional 3rd Party API Credentials (Last.fm, Deezer, Apple Music)
LASTFM_API_KEY=your_lastfm_api_key_here
DEEZER_ARL=your_deezer_arl_cookie_here
APPLE_MUSIC_MEDIA_API_TOKEN=your_apple_music_jwt_bearer_token_here
